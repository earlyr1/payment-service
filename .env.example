# Copy to .env and adjust. docker-compose.yml has working defaults for local development;
# every variable below can also be set in the environment. See src/payment_service/config.py.

# --- secrets (change them!) ---
API_KEY=dev-api-key-change-me-0123456789
WEBHOOK_SIGNING_SECRET=dev-webhook-secret-change-me-0123
POSTGRES_PASSWORD=payments
RABBITMQ_PASSWORD=payments

# --- service tuning (defaults shown) ---
# LOG_LEVEL=INFO
# LOG_FORMAT=json                      # json | console
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10                   # pool size + overflow must be >= 2 * CONSUMER_PREFETCH_COUNT
# CONSUMER_PREFETCH_COUNT=10           # payments processed concurrently by one consumer
# CONSUMER_MAX_ATTEMPTS=3              # total attempts before a message goes to the DLQ
# CONSUMER_RETRY_BASE_DELAY_SECONDS=2  # delay before attempt n+1 = base * 2^(n-1)
# CONSUMER_RETRY_MAX_DELAY_SECONDS=300
# CONSUMER_DELIVERY_LIMIT=10           # broker-side redelivery limit (crash loops)
# GATEWAY_MIN_DELAY_SECONDS=2
# GATEWAY_MAX_DELAY_SECONDS=5
# GATEWAY_SUCCESS_RATE=0.9
# WEBHOOK_TIMEOUT_SECONDS=10
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false  # compose sets true for the demo receiver
# OUTBOX_POLL_INTERVAL_SECONDS=0.5
# OUTBOX_BATCH_SIZE=100
# OUTBOX_RETENTION_HOURS=72
